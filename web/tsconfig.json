{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "types": [],
    "rootDir": ".",
    "outDir": "../build-test",
    "strict": true,
    "noUnusedLocals": true,
    "noEmitOnError": true,
    "skipLibCheck": true
  },
  "include": ["*.ts", "vendor/*.d.ts"]
}
