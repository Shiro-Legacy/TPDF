#   printf '["/tmp/tandem-walk-gui/nav.pdf","/tmp/tandem-walk-gui/no-such-file.pdf","/tmp/tandem-walk-gui/form.pdf"]' > udata/recent-files.json
#   APP=$REPO/crates/target/debug/tandem-pdf
#   $APP --user-data-dir=/tmp/tandem-walk-gui/udata --window-size=1280x820 --theme=light \
#     --walk=$REPO/tests/walk/start-missing-recent.jsonl 2> start.log
# (macOS may report /tmp as /private/tmp: if the missing row does not drop, use the path the
# state dump shows in view.recent.)
