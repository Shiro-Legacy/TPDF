# A2 §4/§6 + §8 — parameterizable dialogs: insert with a range, watermark + header
# with page ranges, page labels set and cleared, and the refusals (bad range, missing
# file, unknown style). Insert's source path is the top-level line key `from` (§8.2).
# Label literals are best-guess; every value filled in after the ops land is in a2/grok.md.
{"cmd": "open", "path": "fixtures/nav.pdf", "expect": {"doc": {"name": "nav.pdf", "pageCount": 3}, "pages": {"count": 3}, "dirty": false, "error": ""}}
# Insert hello.pdf's page 1 after page 1 (the dialog's after/pages are its own numbering).
{"cmd": "insert", "from": "fixtures/hello.pdf", "contents": {"after": 1, "range": "1"}, "expect": {"pages": {"count": 4}, "assemble": {"inserted": 1, "source": "hello.pdf"}, "dirty": true, "error": ""}}
# Refusal: hello.pdf has one page, so "9-12" does not exist in the source.
# `assemble.last.detail` token filled in after ds2 lands; the page count must not move.
{"cmd": "insert", "from": "fixtures/hello.pdf", "contents": {"after": 1, "range": "9-12"}, "expect": {"pages": {"count": 4}}}
# Refusal: a source path that is not there (pickInsertSource's own showError).
{"cmd": "insert", "from": "fixtures/missing-a2.pdf", "contents": {"after": 1, "range": "1"}, "expect": {"pages": {"count": 4}}}
# Stamps over a page range: `decorate.last.pages` is the parsed 0-based list (§8.3).
# A stamp's presence is only reported by the renderer here; the engine-read ceiling is in a2/grok.md.
{"cmd": "watermark", "contents": {"kind": "watermark", "text": "A2 WATERMARK", "pages": "1-2"}, "expect": {"decorate": {"last": {"action": "stamp", "kind": "watermark", "pages": [0, 1], "ok": true}}, "dirty": true, "error": ""}}
{"cmd": "header-footer", "contents": {"kind": "header", "text": "A2 header {page}", "pages": "1-3"}, "expect": {"decorate": {"last": {"action": "stamp", "kind": "header", "pages": [0, 1, 2], "ok": true}}, "dirty": true, "error": ""}}
# Labels on the one-page fixture: style A from page 1 gives ["A"], clear restores ["1"].
{"cmd": "open", "path": "fixtures/hello.pdf", "expect": {"doc": {"name": "hello.pdf", "pageCount": 1}}}
{"cmd": "labels", "contents": {"from": 1, "style": "A", "prefix": "", "start": 1}, "expect": {"decorate": {"labels": ["A"], "last": {"action": "labels-set", "ok": true}}, "dirty": true, "error": ""}}
# A saved copy so verify-roundtrip can read the labels back independently (--labels).
{"cmd": "save-to", "path": "${OUT}/dialogs-labels.pdf", "expect": {"save": {"ok": true, "name": "dialogs-labels.pdf"}, "error": ""}}
# Refusal: "Q" is not one of D|r|R|a|A| — invalid-style, never dirty, labels unmoved (§8.9).
{"cmd": "labels", "contents": {"from": 1, "style": "Q", "prefix": "", "start": 1}, "expect": {"decorate": {"labels": ["A"], "last": {"action": "labels-set", "ok": false, "detail": "invalid-style"}}}}
{"cmd": "labels", "contents": {"clear": true, "from": 1}, "expect": {"decorate": {"labels": ["1"], "last": {"action": "labels-clear", "ok": true}}, "dirty": true, "error": ""}}
