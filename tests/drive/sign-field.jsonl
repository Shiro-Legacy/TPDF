{"cmd":"drag","page":0,"x":72,"y":300,"dx":1,"dy":0,"expect":{"error":"","signatures":[{"field":"Signature1"},{"field":"Signature2"},{"field":"Signature4"}],"revision":1}}
{"cmd":"arm","contents":{"tool":"sigfield"},"expect":{"revision":1}}
{"cmd":"drag","page":0,"x":72,"y":400,"dx":30,"dy":10,"expect":{"error":"Draw a bigger signature field","signatures":[{"field":"Signature1"},{"field":"Signature2"},{"field":"Signature4"}],"revision":1}}
