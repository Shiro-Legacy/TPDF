{"cmd":"arm","contents":{"tool":"sigfield"},"expect":{"revision":0}}
{"cmd":"drag","page":0,"x":72,"y":300,"dx":220,"dy":60,"expect":{"fields":{"last":{"action":"add","name":"Signature4"}},"signatures":[{"field":"Signature1","status":"empty"},{"field":"Signature2","status":"empty"},{"field":"Signature4","status":"empty"}],"dirty":true,"revision":1}}
