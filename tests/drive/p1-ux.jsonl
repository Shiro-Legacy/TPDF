# Phase 1 UX quick wins (docs/rust-and-ux-plan.md §3): armed tools, Escape and stray clicks (X6). Starts on hello.pdf.
{"cmd":"new","expect":{"doc":{"name":"Untitled.pdf"},"tool":null,"revision":0}}
# X6: in Edit text a click on empty page space adds nothing; Add text is an explicit tool.
{"cmd":"mode","contents":{"mode":"edit"},"expect":{"mode":"edit","tool":null}}
{"cmd":"click","page":0,"x":300,"y":400,"expect":{"direct":{"active":null},"dirty":false,"revision":0,"tool":null}}
{"cmd":"arm","contents":{"tool":"add-text"},"expect":{"tool":"Adding text: click empty space on the page"}}
{"cmd":"click","page":0,"x":300,"y":400,"expect":{"direct":{"active":{"kind":"add","page":0,"draft":""}},"revision":0}}
{"cmd":"type","text":"Typed on purpose","expect":{"direct":{"active":{"kind":"add","draft":"Typed on purpose"}}}}
{"cmd":"key","key":"Meta+Enter","expect":{"direct":{"active":null},"dirty":true,"revision":1,"tool":"Adding text: click empty space on the page"}}
# The first Escape clears the new text's focus (if any), a further Escape stops the tool.
{"cmd":"key","key":"Escape"}
{"cmd":"key","key":"Escape","expect":{"tool":null,"revision":1}}
{"cmd":"click","page":0,"x":300,"y":600,"expect":{"direct":{"active":null},"revision":1,"tool":null}}
# X6: in Fill forms a click on empty space adds nothing; Add text box is an explicit tool.
{"cmd":"mode","contents":{"mode":"forms"},"expect":{"mode":"forms","tool":null}}
{"cmd":"click","page":0,"x":300,"y":600,"expect":{"direct":{"active":null},"annots":{"FreeText":0},"revision":1}}
{"cmd":"mode","contents":{"mode":"forms","tool":"textbox"},"expect":{"tool":"Adding text boxes: click the page"}}
{"cmd":"click","page":0,"x":300,"y":600,"expect":{"direct":{"active":{"kind":"textbox","annotId":null}},"revision":1}}
{"cmd":"key","key":"Escape","expect":{"direct":{"active":null},"annots":{"FreeText":0},"tool":"Adding text boxes: click the page"}}
{"cmd":"key","key":"Escape","expect":{"tool":null}}
# X6: Escape stops every armed tool, each named on the chip.
{"cmd":"mode","contents":{"mode":"annotate"},"expect":{"mode":"annotate"}}
{"cmd":"arm","contents":{"tool":"note"},"expect":{"tool":"Placing a note: click the page"}}
{"cmd":"key","key":"Escape","expect":{"tool":null}}
{"cmd":"arm","contents":{"tool":"ink"},"expect":{"tool":"Drawing: drag on the page"}}
{"cmd":"key","key":"Escape","expect":{"tool":null}}
{"cmd":"arm","contents":{"tool":"freetext"},"expect":{"tool":"Placing a text box: click the page"}}
{"cmd":"key","key":"Escape","expect":{"tool":null}}
{"cmd":"arm","contents":{"tool":"link"},"expect":{"tool":"Drawing a link: drag a rectangle"}}
{"cmd":"key","key":"Escape","expect":{"tool":null}}
{"cmd":"mode","contents":{"mode":"forms"}}
{"cmd":"arm","contents":{"tool":"sigfield"},"expect":{"tool":"Drawing a signature field: drag a rectangle"}}
{"cmd":"key","key":"Escape","expect":{"tool":null,"revision":1,"error":""}}
# X7: STATE error keeps the text an agent gets; the bar shows it in plain words, as an error (red).
{"cmd":"fill-text","contents":{"page":0,"x":72,"y":72,"text":" "},"expect":{"error":"fill-text: text is empty","message":{"kind":"error","text":"Text is empty"}}}
