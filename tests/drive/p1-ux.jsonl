# Phase 1 UX quick wins (docs/rust-and-ux-plan.md §3): armed tools, Escape and stray clicks (X6). Starts on hello.pdf.
{"cmd":"new","expect":{"doc":{"name":"Untitled.pdf"},"tool":null,"revision":0}}
# X6: in Edit text a click on empty page space adds nothing; Add text is an explicit tool.
{"cmd":"mode","contents":{"mode":"edit"},"expect":{"mode":"edit","tool":null}}
{"cmd":"click","page":0,"x":300,"y":400,"expect":{"direct":{"active":null},"dirty":false,"revision":0,"tool":null}}
{"cmd":"arm","contents":{"tool":"add-text"},"expect":{"tool":"Adding text: click empty space on the page"}}
{"cmd":"click","page":0,"x":300,"y":400,"expect":{"direct":{"active":{"kind":"add","page":0,"draft":""}},"revision":0}}
{"cmd":"type","text":"Typed on purpose","expect":{"direct":{"active":{"kind":"add","draft":"Typed on purpose"}}}}
{"cmd":"key","key":"Meta+Enter","expect":{"direct":{"active":null},"dirty":true,"revision":1,"tool":"Adding text: click empty space on the page"}}
# The first Escape clears the new text's focus (if any), a further Escape stops the tool.
{"cmd":"key","key":"Escape"}
{"cmd":"key","key":"Escape","expect":{"tool":null,"revision":1}}
{"cmd":"click","page":0,"x":300,"y":600,"expect":{"direct":{"active":null},"revision":1,"tool":null}}
# X6: in Fill forms a click on empty space adds nothing; Add text box is an explicit tool.
{"cmd":"mode","contents":{"mode":"forms"},"expect":{"mode":"forms","tool":null}}
{"cmd":"click","page":0,"x":300,"y":600,"expect":{"direct":{"active":null},"annots":{"FreeText":0},"revision":1}}
{"cmd":"mode","contents":{"mode":"forms","tool":"textbox"},"expect":{"tool":"Adding text boxes: click the page"}}
{"cmd":"click","page":0,"x":300,"y":600,"expect":{"direct":{"active":{"kind":"textbox","annotId":null}},"revision":1}}
{"cmd":"key","key":"Escape","expect":{"direct":{"active":null},"annots":{"FreeText":0},"tool":"Adding text boxes: click the page"}}
{"cmd":"key","key":"Escape","expect":{"tool":null}}
# X6: Escape stops every armed tool, each named on the chip.
{"cmd":"mode","contents":{"mode":"annotate"},"expect":{"mode":"annotate"}}
{"cmd":"arm","contents":{"tool":"note"},"expect":{"tool":"Placing a note: click the page"}}
{"cmd":"key","key":"Escape","expect":{"tool":null}}
{"cmd":"arm","contents":{"tool":"ink"},"expect":{"tool":"Drawing: drag on the page"}}
{"cmd":"key","key":"Escape","expect":{"tool":null}}
{"cmd":"arm","contents":{"tool":"freetext"},"expect":{"tool":"Placing a text box: click the page"}}
{"cmd":"key","key":"Escape","expect":{"tool":null}}
{"cmd":"arm","contents":{"tool":"link"},"expect":{"tool":"Drawing a link: drag a rectangle"}}
{"cmd":"key","key":"Escape","expect":{"tool":null}}
{"cmd":"mode","contents":{"mode":"forms"}}
{"cmd":"arm","contents":{"tool":"sigfield"},"expect":{"tool":"Drawing a signature field: drag a rectangle"}}
{"cmd":"key","key":"Escape","expect":{"tool":null,"revision":1,"error":""}}
# X7: STATE error keeps the text an agent gets; the bar shows it in plain words, as an error (red).
{"cmd":"fill-text","contents":{"page":0,"x":72,"y":72,"text":" "},"expect":{"error":"fill-text: text is empty","message":{"kind":"error","text":"Text is empty"}}}
# Item 5: Highlight, Underline and Strike out act on a text selection first, else on the search match.
{"cmd":"open","path":"fixtures/hello.pdf","expect":{"doc":{"name":"hello.pdf"},"annots":{"Highlight":0}}}
{"cmd":"mode","contents":{"mode":"annotate"},"expect":{"markup":{"selection":null}}}
{"cmd":"find","contents":{"query":"PDF4All"},"expect":{"search":{"query":"PDF4All","count":1}}}
{"cmd":"highlight","expect":{"annots":{"Highlight":1},"markup":{"last":{"type":"Highlight","source":"search"}},"error":""}}
{"cmd":"select","contents":{"text":"PDF4All"},"expect":{"markup":{"selection":"PDF4All"},"error":""}}
{"cmd":"strikeout","expect":{"annots":{"StrikeOut":1},"markup":{"last":{"type":"StrikeOut","source":"selection","text":"PDF4All"},"selection":null},"error":""}}
{"cmd":"highlight-all","expect":{"annots":{"Highlight":2},"error":""}}
# Item 6: placing a note opens its editor at once; a note closed empty is discarded, never added.
{"cmd":"arm","contents":{"tool":"note"},"expect":{"tool":"Placing a note: click the page"}}
{"cmd":"click","page":0,"x":400,"y":400,"expect":{"direct":{"active":{"kind":"note","page":0,"draft":""}},"annots":{"Text":0},"tool":null}}
{"cmd":"key","key":"Escape","expect":{"direct":{"active":null},"annots":{"Text":0}}}
{"cmd":"arm","contents":{"tool":"note"}}
{"cmd":"click","page":0,"x":400,"y":400,"expect":{"direct":{"active":{"kind":"note","draft":""}}}}
{"cmd":"key","key":"Meta+Enter","expect":{"direct":{"active":null},"annots":{"Text":0},"announcement":"Note discarded: it had no text."}}
{"cmd":"arm","contents":{"tool":"note"}}
{"cmd":"click","page":0,"x":400,"y":400,"expect":{"direct":{"active":{"kind":"note","draft":""}}}}
{"cmd":"type","text":"Check this figure","expect":{"direct":{"active":{"kind":"note","draft":"Check this figure"}}}}
{"cmd":"key","key":"Meta+Enter","expect":{"direct":{"active":null},"annots":{"Text":1},"error":""}}
# Item 7: Save As writes a new file and the window then edits it; save-to (Save a copy) leaves it on the original.
{"cmd":"new","expect":{"doc":{"name":"Untitled.pdf"}}}
{"cmd":"save-to","path":"${OUT}/orig.pdf","expect":{"save":{"ok":true,"name":"orig.pdf"}}}
{"cmd":"open","path":"${OUT}/orig.pdf","expect":{"doc":{"name":"orig.pdf"},"dirty":false}}
{"cmd":"note","contents":"edit one","expect":{"dirty":true,"annots":{"Text":1}}}
{"cmd":"save-to","path":"${OUT}/copy.pdf","expect":{"save":{"ok":true,"name":"copy.pdf"},"doc":{"name":"orig.pdf"},"dirty":true}}
{"cmd":"save-as","path":"${OUT}/renamed.pdf","expect":{"save":{"ok":true,"name":"renamed.pdf","as":true},"doc":{"name":"renamed.pdf"},"dirty":false,"error":""}}
{"cmd":"note","contents":"edit two","expect":{"dirty":true,"annots":{"Text":2}}}
{"cmd":"save-in-place","expect":{"save":{"ok":true,"name":"renamed.pdf","inPlace":true},"doc":{"name":"renamed.pdf"},"dirty":false,"error":""}}
# Review fix 7: Save As onto the open file under another name for it (a link the test made) is a plain Save.
{"cmd":"note","contents":"edit three","expect":{"dirty":true,"annots":{"Text":3}}}
{"cmd":"save-as","path":"${OUT}/alias.pdf","expect":{"save":{"ok":true,"as":true,"inPlace":true},"doc":{"name":"renamed.pdf"},"dirty":false,"error":""}}
# Item 8: the first Save of a filled form asks once; answered "Save Over", it saves over the file and never asks again.
{"cmd":"open","path":"fixtures/form2.pdf","expect":{"doc":{"name":"form2.pdf"}}}
{"cmd":"save-to","path":"${OUT}/myform.pdf","expect":{"save":{"ok":true,"name":"myform.pdf"}}}
{"cmd":"open","path":"${OUT}/myform.pdf","expect":{"doc":{"name":"myform.pdf"},"fill":{"saveAsCopy":false}}}
{"cmd":"fields","contents":{"action":"fill","name":"name","value":"Ada"},"expect":{"fields":{"values":{"name":"Ada"}},"fill":{"saveAsCopy":true}}}
{"cmd":"save-in-place","filled":"over","expect":{"save":{"ok":true,"name":"myform.pdf","inPlace":true},"doc":{"name":"myform.pdf"},"dirty":false,"fill":{"saveAsCopy":false},"error":""}}
{"cmd":"fields","contents":{"action":"fill","name":"name","value":"Ada Lovelace"},"expect":{"fill":{"saveAsCopy":false},"dirty":true}}
{"cmd":"save-in-place","expect":{"save":{"ok":true,"name":"myform.pdf","inPlace":true},"doc":{"name":"myform.pdf"},"dirty":false,"error":""}}
# Item 9: the certificate dialog's button says what it does and waits for a certificate.
{"cmd":"cert-sign-open","expect":{"sign":{"certificateDialog":{"ready":false,"label":"Sign and save as…"}}}}
{"cmd":"key","key":"Escape","expect":{"sign":{"certificateDialog":null}}}
# Review fix: the `filled` answer holds for its own line only: the next filled form is not saved over.
{"cmd":"open","path":"fixtures/form2.pdf","expect":{"doc":{"name":"form2.pdf"}}}
{"cmd":"save-to","path":"${OUT}/second.pdf","expect":{"save":{"ok":true,"name":"second.pdf"}}}
{"cmd":"open","path":"${OUT}/second.pdf","expect":{"doc":{"name":"second.pdf"}}}
{"cmd":"fields","contents":{"action":"fill","name":"name","value":"Bea"},"expect":{"fill":{"saveAsCopy":true}}}
{"cmd":"save-in-place","path":"${OUT}/second-new.pdf","expect":{"save":{"ok":true,"name":"second-new.pdf"},"doc":{"name":"second-new.pdf"},"dirty":false,"error":""}}
# Review fix 6: with a protection change still waiting for Save, signing says so and writes nothing.
{"cmd":"open","path":"fixtures/edit-tj.pdf","expect":{"doc":{"name":"edit-tj.pdf"}}}
{"cmd":"encrypt","contents":{"user":"u1","owner":"o1","permissions":["print"]},"to":"${OUT}/protected-copy.pdf","expect":{"save":{"ok":true,"name":"protected-copy.pdf"}}}
{"cmd":"sign","contents":{"cert":"fixtures/p5/leaf.p12","password":"pdf4all","page":1,"rect":null,"reason":"pending","certify":false},"to":"${OUT}/should-not-exist.pdf","expect":{"sign":{"last":{"op":"sign","ok":false,"reason":"security-pending"}}}}
{"cmd":"key","key":"Escape","expect":{"sign":{"certificateDialog":null}}}
