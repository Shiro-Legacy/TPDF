# Unlock the RC4 fixture, rotate the shown page, print to a file. The password must not appear in any STATE.
{"cmd": "open", "path": "fixtures/encrypted.pdf", "expect": {"doc": {"name": "encrypted.pdf", "needsPassword": true}}}
{"cmd": "password", "contents": "pdf4all-user", "expect": {"doc": {"needsPassword": false}, "error": ""}}
{"cmd": "rotate-right", "expect": {"pages": {"rotate": [90]}, "dirty": true}}
{"cmd": "wait", "ms": 100, "expect": {"pages": {"rotate": [90]}}}
{"cmd": "print-to", "path": "${OUT}/printed.pdf", "range": "1", "expect": {"print": {"ok": true, "pages": 1}}}
