# P6 U4 direct manipulation IV (contract-p6-unit4.md §6.2 as amended by §9.1, §9.3, §9.8, §9.18): links on the page, /Tabs order.
# fixtures/p6/links.pdf (sha 0ac413b0…d0bc), Letter, y-down page pt (y_down = 792 - y_up). Page 0 centres (annotId = /Annots object number):
# L1 uri https://example.org/one (136, 82) rect [72,72,200,92] annotId 10 · L2 /Dest page 2 (136, 132) rect [72,122,200,142] annotId 11
# L5 bare /Link (136, 157) annotId 12, skipped by getLinks · L3 blocked ftp://example.org/x (136, 182) rect [72,172,200,192] annotId 13
# Empty draw band y 292..692 → drags at (300, 400), (300, 450), (300, 300), (300, 500). Page 1 /Rotate 90: L4 uri https://example.org/rot,
# page-space rect [700,72,720,200] annotId 14, centre (710, 136). Page 2 "Target".
# fixtures/p6/tabs.pdf (sha b90c5db2…7326), all upright, y-down centres: a1/a2/a3 (132, 82/132/182), b1/b2/b3 (360, 82/132/182) page 0 /Tabs C;
# t1/t2/t3 (132/280/428, 82) page 1 /Tabs A (/Annots t3 t1 t2); s1/s2/s3 same x page 2 /Tabs S (struct s2 s3 s1); u1/u2 (132/280, 82) page 3 /Tabs S, no structure.
# expect is exact (main.ts matches): revision is absolute (every mutate, undo and redo adds 1). No expect carries a gesture-produced rect
# (§9.8): moves, resizes, nudges, drawn rects and the persisted rotated move are checked in tests/p6-drive4.test.mjs via pick().
{"cmd":"open","path":"fixtures/p6/links.pdf","expect":{"doc":{"name":"links.pdf","pageCount":3},"dirty":false,"revision":0,"page":0,"links":[{"id":0,"annotId":10,"rect":[72,72,200,92],"kind":"uri","uri":"https://example.org/one"},{"id":1,"annotId":11,"rect":[72,122,200,142],"kind":"page","page":2},{"id":2,"annotId":13,"rect":[72,172,200,192],"kind":"blocked","uri":"ftp://example.org/x"}]}}
# Read mode: a click follows the link (page link → goTo, uri → P2_LINK in a drive, blocked → announced, never opened).
{"cmd":"mode","contents":{"mode":"read"},"expect":{"mode":"read","direct":{"mode":"read","links":3}}}
{"cmd":"click","page":0,"x":136,"y":132,"expect":{"page":2,"nav":{"last":{"action":"link-follow","kind":"page","page":2}},"revision":0}}
{"cmd":"goto","contents":{"page":0},"expect":{"page":0,"direct":{"links":3}}}
{"cmd":"click","page":0,"x":136,"y":82,"expect":{"page":0,"nav":{"last":{"action":"link-follow","kind":"uri","uri":"https://example.org/one"}},"revision":0}}
{"cmd":"click","page":0,"x":136,"y":182,"expect":{"page":0,"nav":{"last":{"action":"link-follow","kind":"blocked"}},"revision":0}}
# Annotate mode: click focuses; grip drag moves (one link-set), undo; se handle resizes.
{"cmd":"mode","contents":{"mode":"annotate"},"expect":{"mode":"annotate","direct":{"mode":"annotate","links":3,"active":null}}}
{"cmd":"click","page":0,"x":136,"y":82,"expect":{"direct":{"active":{"kind":"link","annotId":10,"id":0,"page":0,"rect":[72,72,200,92],"target":{"kind":"uri","uri":"https://example.org/one"},"editing":false}},"revision":0}}
{"cmd":"handle","page":0,"x":136,"y":82,"handle":"grip","dx":30,"dy":40,"expect":{"nav":{"last":{"action":"link-set","index":0}},"links":[{"annotId":10,"kind":"uri"},{"annotId":11},{"annotId":13}],"dirty":true,"revision":1}}
{"cmd":"undo","expect":{"links":[{"annotId":10,"rect":[72,72,200,92]},{"annotId":11},{"annotId":13}],"dirty":false,"canRedo":true,"revision":2}}
{"cmd":"handle","page":0,"x":136,"y":82,"handle":"se","dx":20,"dy":10,"expect":{"nav":{"last":{"action":"link-set","index":0}},"links":[{"annotId":10},{"annotId":11},{"annotId":13}],"dirty":true,"revision":3}}
# Plain arrows nudge a focused link: → 1 pt, ⇧↓ 10 pt (one link-set each).
{"cmd":"click","page":0,"x":136,"y":90,"expect":{"direct":{"active":{"kind":"link","annotId":10,"id":0,"editing":false}},"revision":3}}
{"cmd":"key","key":"ArrowRight","expect":{"nav":{"last":{"action":"link-set","index":0}},"direct":{"active":{"kind":"link","annotId":10}},"revision":4}}
{"cmd":"key","key":"Shift+ArrowDown","expect":{"nav":{"last":{"action":"link-set","index":0}},"direct":{"active":{"kind":"link","annotId":10}},"revision":5}}
# Enter opens the inline target editor with the whole value selected; type replaces it; Enter commits.
