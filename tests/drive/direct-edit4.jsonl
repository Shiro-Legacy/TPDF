{"cmd":"type","text":"https://example.org/changed","expect":{"direct":{"active":{"kind":"link","editing":true,"draft":"https://example.org/changed"}},"revision":5}}
{"cmd":"key","key":"Enter","expect":{"links":[{"annotId":10,"kind":"uri","uri":"https://example.org/changed"},{"annotId":11},{"annotId":13}],"direct":{"active":{"kind":"link","annotId":10,"editing":false}},"nav":{"last":{"action":"link-set","index":0}},"error":"","revision":6}}
# A refused scheme keeps the editor and draft open and writes nothing (§9.3 exact message); Escape closes it.
{"cmd":"click","page":0,"x":136,"y":95,"expect":{"direct":{"active":{"kind":"link","annotId":10,"editing":false}},"revision":6}}
{"cmd":"key","key":"Enter","expect":{"direct":{"active":{"kind":"link","annotId":10,"editing":true,"draft":"https://example.org/changed"}},"revision":6}}
{"cmd":"type","text":"ftp://nope","expect":{"direct":{"active":{"kind":"link","editing":true,"draft":"ftp://nope"}},"revision":6}}
{"cmd":"key","key":"Enter","expect":{"error":"link-set: ftp: is not a link this app opens","nav":{"last":{"action":"link-set","index":0,"detail":"scheme"}},"links":[{"annotId":10,"uri":"https://example.org/changed"},{"annotId":11},{"annotId":13}],"direct":{"active":{"kind":"link","editing":true,"draft":"ftp://nope"}},"dirty":true,"revision":6}}
{"cmd":"key","key":"Escape","expect":{"direct":{"active":null},"links":[{"annotId":10,"uri":"https://example.org/changed"},{"annotId":11},{"annotId":13}],"revision":6}}
