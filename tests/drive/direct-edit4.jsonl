{"cmd":"click","page":0,"x":136,"y":95,"expect":{"direct":{"active":{"kind":"link","annotId":10,"editing":false}},"error":"","revision":7}}
{"cmd":"key","key":"Enter","expect":{"direct":{"active":{"kind":"link","annotId":10,"editing":true,"draft":"https://example.org/changed"}},"revision":7}}
{"cmd":"type","text":"ftp://nope","expect":{"direct":{"active":{"kind":"link","editing":true,"draft":"ftp://nope"}},"revision":7}}
{"cmd":"mode","contents":{"mode":"read"},"expect":{"mode":"read","direct":{"mode":"read","active":null},"revision":7}}
{"cmd":"wait","ms":500,"expect":{"error":"","nav":{"last":{"action":"link-set","index":0,"detail":"scheme"}},"links":[{"annotId":10,"kind":"uri","uri":"https://example.org/changed"},{"annotId":11,"kind":"page","page":0},{"annotId":13}],"direct":{"active":null},"dirty":true,"revision":7}}
{"cmd":"mode","contents":{"mode":"annotate"},"expect":{"mode":"annotate","direct":{"mode":"annotate","links":3,"active":null},"error":"","revision":7}}
