{"cmd":"key","key":"Enter","expect":{"direct":{"active":{"kind":"link","annotId":11,"editing":true,"draft":"3"}},"revision":6}}
{"cmd":"type","text":"1","expect":{"direct":{"active":{"kind":"link","annotId":11,"editing":true,"draft":"1"}},"revision":6}}
{"cmd":"key","key":"Enter","expect":{"links":[{"annotId":10},{"annotId":11,"kind":"page","page":0},{"annotId":13}],"nav":{"last":{"action":"link-set","index":1}},"error":"","revision":7}}
