{"cmd":"sign-place","contents":{"page":0,"x":300,"y":300},"expect":{"error":"","annots":{"Ink":1,"Stamp":1},"fill":{"lastSignature":{"op":"add"}},"revision":4,"announcement":"Added signature"}}
