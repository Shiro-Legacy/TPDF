# sign-merge (contract-sign-merge.md D6/D7 c): 18 steps, 0 click lines. Needs ${OUT}/signature.png (a copy of fixtures/img-rgb.png, 300x200 px) staged by the caller. A copy of hello.pdf: sign-draw takes the image through the pad's "Use an image…" and Save; sign-place puts an image signature Stamp centred on the point; a drag and + move and resize it; a drawing replaces the image and places as Ink; Delete and undo work on both kinds; the bare menu op `sign` arms placement; two kinds in one sign-draw, two images and a non-image refuse; merged.pdf keeps both. Pinned in tests/sign-merge.test.mjs.
{"cmd":"open","path":"fixtures/hello.pdf","expect":{"doc":{"name":"hello.pdf"},"dirty":false,"error":""}}
{"cmd":"save-to","path":"${OUT}/hello-copy.pdf","expect":{"save":{"ok":true,"name":"hello-copy.pdf"},"error":""}}
{"cmd":"open","path":"${OUT}/hello-copy.pdf","expect":{"doc":{"name":"hello-copy.pdf"},"dirty":false,"revision":0,"error":""}}
{"cmd":"sign-draw","images":["${OUT}/signature.png"],"contents":{"image":true},"expect":{"error":"","fill":{"signature":{"saved":true,"kind":"image","strokes":0,"points":0,"armed":false,"pad":false}},"dirty":false,"revision":0}}
{"cmd":"sign-place","contents":{"page":0,"x":300,"y":650},"expect":{"mode":"forms","error":"","annots":{"Stamp":1},"fill":{"filled":true,"lastSignature":{"op":"add"}},"dirty":true,"revision":1,"announcement":"Added signature"}}
