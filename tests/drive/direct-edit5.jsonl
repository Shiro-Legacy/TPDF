# §3.1 plain arrows on a focused object: → 1 pt, ⇧↓ 10 pt, one op each; two undos.
{"cmd":"click","page":0,"x":430,"y":72,"expect":{"direct":{"active":{"kind":"object","name":"Im2","page":0}},"revision":0}}
{"cmd":"key","key":"ArrowRight","expect":{"content":{"edited":{"kind":"image","action":"move","name":"Im2"}},"direct":{"active":{"kind":"object","name":"Im2"}},"dirty":true,"revision":1}}
{"cmd":"key","key":"Shift+ArrowDown","expect":{"content":{"edited":{"kind":"image","action":"move","name":"Im2"}},"direct":{"active":{"kind":"object","name":"Im2"}},"revision":2}}
{"cmd":"undo","expect":{"revision":3,"canRedo":true,"dirty":true}}
{"cmd":"undo","expect":{"revision":4,"canRedo":true,"dirty":false}}
