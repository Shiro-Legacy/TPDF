{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": [
      "deb",
      "appimage"
    ],
    "publisher": "Tandem PDF contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.png"
    ],
    "longDescription": "Read, fill, sign, edit and redact PDF files on your computer. Nothing is uploaded.",
    "linux": {
      "deb": {
        "depends": [
          "libdbus-1-3"
        ],
        "recommends": [
          "xdg-utils",
          "libglib2.0-bin"
        ],
        "section": "graphics",
        "desktopTemplate": "linux/tandem-pdf.desktop",
        "files": {
          "/usr/share/doc/tandem-pdf/copyright": "../../LICENSE"
        }
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
