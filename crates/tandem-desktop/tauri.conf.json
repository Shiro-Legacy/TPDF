{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tandem PDF",
  "version": "0.1.2",
  "identifier": "com.shiro-legacy.tandem-pdf",
  "build": {
    "frontendDist": "../tandem-ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: tandem: http://tandem.localhost; connect-src 'self' ipc: http://ipc.localhost tandem: http://tandem.localhost",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "copyright": "© 2026 Tandem PDF contributors. MIT licence.",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": null,
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist",
      "dmg": {
        "windowSize": {
          "width": 540,
          "height": 380
        }
      }
    },
    "resources": {
      ".stage/fixtures/": "fixtures/",
      ".stage/licenses/": "licenses/",
      ".stage/fonts/": "fonts/"
    },
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF document",
        "role": "Editor",
        "rank": "Alternate",
        "contentTypes": [
          "com.adobe.pdf"
        ],
        "mimeType": "application/pdf"
      }
    ],
    "shortDescription": "A local, offline PDF editor",
    "longDescription": "Read, fill, sign, edit and redact PDF files on your Mac. Nothing is uploaded."
  }
}
