{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "noUnusedLocals": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    "rootDir": "src",
    "outDir": "build"
  },
  "include": ["src/preload.cts"]
}
